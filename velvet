        let currentSubjectFilter = 'all';
        let currentSearchQuery = '';
        let favorites = JSON.parse(localStorage.getItem('collective_favs') || '[]');
        let showOnlyFavs = false;
        let currentLang = 'en';

        let customAdData = JSON.parse(localStorage.getItem('collective_custom_ad') || JSON.stringify({
            title: "Join Collective Academic Network",
            desc: "Get unlimited research downloads & formula cheat sheets for universities.",
            url: "https://example.com",
            btnText: "Explore Premium"
        }));

        document.addEventListener('DOMContentLoaded', () => {
            renderCategoryTabs();
            renderSidebarCategories();
            renderCards();
            renderCustomAdSlot();
            setupSearchListeners();
            updateFavCount();
        });

        function renderCategoryTabs() {
            const container = document.getElementById('categoryTabs');
            container.innerHTML = categories.map(cat => `
                <button onclick="setCategory('${cat.id}')" 
                        class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold flex items-center gap-2 transition-all duration-200 ${
                            currentSubjectFilter === cat.id 
                            ? 'bg-brand-600 text-white shadow-lg shadow-brand-500/30' 
                            : 'bg-slate-900 text-slate-400 hover:text-slate-200 hover:bg-slate-800'
                        }">
                    <i class="fa-solid ${cat.icon}"></i>
                    <span>${cat.label}</span>
                </button>
            `).join('');
        }

        function renderSidebarCategories() {
            const container = document.getElementById('sidebarCategories');
            container.innerHTML = categories.map(cat => `
                <li>
                    <button onclick="setCategory('${cat.id}')" 
                            class="w-full text-left px-3 py-2 rounded-lg text-xs font-medium flex items-center justify-between transition ${
                                currentSubjectFilter === cat.id ? 'bg-brand-600/20 text-brand-400 font-bold border border-brand-500/30' : 'text-slate-400 hover:bg-slate-800 hover:text-slate-200'
                            }">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid ${cat.icon} text-[10px]"></i>
                            ${cat.label}
                        </span>
                        <span class="text-[10px] bg-slate-800 px-1.5 py-0.5 rounded text-slate-400">
                            ${cat.id === 'all' ? knowledgeData.length : knowledgeData.filter(i => i.subject === cat.id).length}
                        </span>
                    </button>
                </li>
            `).join('');
        }

        function setCategory(catId) {
            currentSubjectFilter = catId;
            showOnlyFavs = false;
            document.getElementById('favFilterBtn').classList.remove('text-amber-400');
            renderCategoryTabs();
            renderSidebarCategories();
            
            const catObj = categories.find(c => c.id === catId);
            document.getElementById('currentCategoryTitle').innerText = catObj ? catObj.label + " Formulas & Theories" : "Formulas";
            
            renderCards();
        }

        function setupSearchListeners() {
            const mainSearch = document.getElementById('searchInput');
            const mobileSearch = document.getElementById('mobileSearchInput');

            const handleSearch = (e) => {
                currentSearchQuery = e.target.value.toLowerCase().trim();
                renderCards();
            };

            mainSearch.addEventListener('input', handleSearch);
            mobileSearch.addEventListener('input', handleSearch);
        }

        function renderCards() {
            const grid = document.getElementById('cardsGrid');
            const sortBy = document.getElementById('sortBy').value;

            let filtered = knowledgeData.filter(item => {
                const matchesSubject = (currentSubjectFilter === 'all') || (item.subject === currentSubjectFilter);
                const matchesSearch = !currentSearchQuery || 
                    item.title.toLowerCase().includes(currentSearchQuery) || 
                    item.explanation.toLowerCase().includes(currentSearchQuery) ||
                    item.latex.toLowerCase().includes(currentSearchQuery) ||
                    item.subjectName.toLowerCase().includes(currentSearchQuery);
                const matchesFav = !showOnlyFavs || favorites.includes(item.id);

                return matchesSubject && matchesSearch && matchesFav;
            });

            if (sortBy === 'title') {
                filtered.sort((a, b) => a.title.localeCompare(b.title));
            } else if (sortBy === 'subject') {
                filtered.sort((a, b) => a.subjectName.localeCompare(b.subjectName));
            }

            document.getElementById('resultsCount').innerText = `${filtered.length} Items`;

            if (filtered.length === 0) {
                grid.innerHTML = '';
                document.getElementById('noResultsState').classList.remove('hidden');
                return;
            } else {
                document.getElementById('noResultsState').classList.add('hidden');
            }

            grid.innerHTML = filtered.map(item => {
                const isFav = favorites.includes(item.id);
                return `
                    <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 hover:border-brand-500/50 transition-all duration-300 shadow-md flex flex-col justify-between group">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-slate-900 text-brand-400 border border-slate-700">
                                    ${item.subjectName}
                                </span>
                                <button onclick="toggleFavorite('${item.id}', event)" class="text-slate-500 hover:text-amber-400 transition p-1" title="Save Formula">
                                    <i class="fa-${isFav ? 'solid' : 'regular'} fa-bookmark text-base ${isFav ? 'text-amber-400' : ''}"></i>
                                </button>
                            </div>

                            <h3 class="text-lg font-bold text-white group-hover:text-brand-400 transition-colors mb-1">${item.title}</h3>
                            <p class="text-xs text-slate-400 mb-4 flex items-center gap-1">
                                <i class="fa-solid fa-user-graduate text-[10px] text-slate-500"></i> ${item.author}
                            </p>

                            <div class="bg-slate-950 border border-slate-800 rounded-lg p-4 mb-4 text-center overflow-x-auto min-h-[70px] flex items-center justify-center">
                                <span class="text-brand-300 font-serif text-lg font-semibold">\\[${item.latex}\\]</span>
                            </div>

                            <p class="text-xs text-slate-300 line-clamp-3 leading-relaxed mb-4">
                                ${item.explanation}
                            </p>
                        </div>

                        <div class="pt-3 border-t border-slate-700/50 flex items-center justify-between">
                            <button onclick="openModal('${item.id}')" class="w-full bg-slate-900 hover:bg-brand-600 hover:text-white text-brand-400 text-xs font-semibold py-2.5 rounded-lg border border-slate-700 hover:border-brand-500 transition-all flex items-center justify-center gap-2">
                                <i class="fa-solid fa-expand"></i>
                                <span data-i18n="view_details">View Proof & Video</span>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            if (window.MathJax && window.MathJax.typesetPromise) {
                window.MathJax.typesetPromise();
            }
        }

        function toggleFavorite(id, e) {
            if (e) e.stopPropagation();
            if (favorites.includes(id)) {
                favorites = favorites.filter(favId => favId !== id);
            } else {
                favorites.push(id);
            }
            localStorage.setItem('collective_favs', JSON.stringify(favorites));
            updateFavCount();
            renderCards();
        }

        function updateFavCount() {
            const badge = document.getElementById('favCount');
            badge.innerText = favorites.length;
            badge.style.opacity = favorites.length > 0 ? '1' : '0';
        }

        function toggleFavoritesFilter() {
            showOnlyFavs = !showOnlyFavs;
            const btn = document.getElementById('favFilterBtn');
            if (showOnlyFavs) {
                btn.classList.add('text-amber-400');
                document.getElementById('currentCategoryTitle').innerText = "Bookmarked Formulas";
            } else {
                btn.classList.remove('text-amber-400');
                setCategory(currentSubjectFilter);
            }
            renderCards();
        }

        function openModal(id) {
            const item = knowledgeData.find(i => i.id === id);
            if (!item) return;

            document.getElementById('modalSubject').innerText = item.subjectName;
            document.getElementById('modalTitle').innerText = item.title;
            document.getElementById('modalFormula').innerHTML = `\\[${item.latex}\\]`;
            document.getElementById('modalExplanation').innerText = item.explanation;
            document.getElementById('modalExample').innerText = item.example;
            document.getElementById('modalDiagram').innerHTML = item.diagramSvg || '<span class="text-xs text-slate-500">Diagram Visualization Placeholder</span>';
            document.getElementById('modalVideoFrame').src = item.videoUrl;

            document.getElementById('detailModal').classList.remove('hidden');

            if (window.MathJax && window.MathJax.typesetPromise) {
                window.MathJax.typesetPromise();
            }
        }

        function closeModal() {
            document.getElementById('detailModal').classList.add('hidden');
            document.getElementById('modalVideoFrame').src = '';
        }

        function renderCustomAdSlot() {
            const container = document.getElementById('customAdSlot');
            container.innerHTML = `
                <i class="fa-solid fa-bullhorn text-2xl text-amber-400"></i>
                <h4 class="text-xs font-bold text-white">${customAdData.title}</h4>
                <p class="text-[11px] text-slate-300 leading-snug">${customAdData.desc}</p>
                <a href="${customAdData.url}" target="_blank" rel="noopener" class="mt-1 px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs rounded transition block w-full text-center">
                    ${customAdData.btnText}
                </a>
            `;
        }

        function toggleAdManagerModal() {
            const modal = document.getElementById('adManagerModal');
            if (modal.classList.contains('hidden')) {
                document.getElementById('adTitleInput').value = customAdData.title;
                document.getElementById('adDescInput').value = customAdData.desc;
                document.getElementById('adUrlInput').value = customAdData.url;
                document.getElementById('adBtnTextInput').value = customAdData.btnText;
                modal.classList.remove('hidden');
            } else {
                modal.classList.add('hidden');
            }
        }

        function saveCustomAd(e) {
            e.preventDefault();
            customAdData = {
                title: document.getElementById('adTitleInput').value,
                desc: document.getElementById('adDescInput').value,
                url: document.getElementById('adUrlInput').value,
                btnText: document.getElementById('adBtnTextInput').value
            };
            localStorage.setItem('collective_custom_ad', JSON.stringify(customAdData));
            renderCustomAdSlot();
            toggleAdManagerModal();
        }

        function changeLanguage(langCode) {
            currentLang = langCode;
            const langDict = translations[langCode] || translations.en;
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (langDict[key]) {
                    el.innerText = langDict[key];
                }
            });

            const selectEl = document.querySelector('.goog-te-combo');
            if (selectEl) {
                const gLangCode = langCode === 'zh' ? 'zh-CN' : langCode;
                selectEl.value = gLangCode;
                selectEl.dispatchEvent(new Event('change'));
            }
        }

        function resetFilters() {
            currentSearchQuery = '';
            document.getElementById('searchInput').value = '';
            document.getElementById('mobileSearchInput').value = '';
            setCategory('all');
        }
    </script>
